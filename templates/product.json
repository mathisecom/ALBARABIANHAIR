26 0.862653C8.47683 0.862653 8.54626 0.880489 8.60809 0.914506ZM8.43035 1.77282L8.40626 1.75957L8.38216 1.77282L4.66732 3.81563L4.58765 3.85945L4.66732 3.90326L8.38216 5.94607L8.40626 5.95932L8.43035 5.94607L12.1452 3.90326L12.2249 3.85945L12.1452 3.81563L8.43035 1.77282ZM12.6491 9.71998L12.675 9.70573V9.67617V4.65163V4.56707L12.6009 4.60782L8.85091 6.67032L8.82501 6.68457V6.71413V11.7387V11.8232L8.8991 11.7825L12.6491 9.71998Z\" fill=\"black\" stroke=\"#E9E9E9\" stroke-width=\"0.1\"></path>\n          <path d=\"M4.0625 6.78131H0.5625V6.09381H4.0625V6.78131ZM5 10.5313H1.5V9.84381H5V10.5313ZM5.9375 8.65631H2.4375V7.96881H5.9375V8.65631Z\" fill=\"black\" stroke=\"#FBFAF9\" stroke-width=\"0.25\"></path>\n        </svg>\n        <p id=\"delivery-text\">¡Ordena ahora y recíbelo el <span id=\"delivery-date\">viernes 7 de noviembre</span></p>\n      </div>\n\n      <script>\n        function calculateDeliveryDate(country) {\n          let today = new Date();\n          let deliveryDate;\n\n          if (country === 'France') {\n            deliveryDate = new Date(today.setDate(today.getDate() + 6));\n          } else if (country === 'Europe') {\n            deliveryDate = new Date(today.setDate(today.getDate() + 6));\n          } else {\n            deliveryDate = new Date(today.setDate(today.getDate() + 6));\n          }\n\n          let options = { weekday: 'long', month: 'long', day: 'numeric' };\n          return deliveryDate.toLocaleDateString('es-ES', options);\n        }\n\n        function fetchCountry() {\n          fetch('https://ipapi.co/json/')\n            .then(response => response.json())\n            .then(data => {\n              let country = data.country_name;\n              let deliveryDate = calculateDeliveryDate(country);\n              document.getElementById('delivery-date').textContent = deliveryDate;\n            })\n            .catch(error => {\n              console.error('Error al obtener la ubicación:', error);\n              let deliveryDate = calculateDeliveryDate('France');\n              document.getElementById('delivery-date').textContent = deliveryDate;\n            });\n        }\n\n        fetchCountry();\n      </script>\n    </div>\n  </div>\n</div>"
